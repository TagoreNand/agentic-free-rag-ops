# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
EMBED_MODEL=nomic-embed-text

# Web fetching (no API keys required)
WIKI_SEARCH_ENDPOINT=https://en.wikipedia.org/w/api.php
WIKI_PAGE_SUMMARY_ENDPOINT=https://en.wikipedia.org/api/rest_v1/page/summary

# Safety / optional capabilities
ENABLE_CODE_RUN=false
MAX_CODE_RUN_SECONDS=20

# Behavior
MAX_STEPS=6
RAG_TOP_K=5
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

